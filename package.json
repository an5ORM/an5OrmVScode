{
  "name": "an5-orm-vscode",
  "displayName": "AN5 ORM Schema Tooling",
  "description": "AN5 ORM workspace, secure database connections, schema tooling and MCP integration.",
  "version": "1.1.4",
  "publisher": "an5orm",
  "author": "an5ORM",
  "homepage": "https://github.com/an5ORM/an5OrmVScode",
  "repository": {
    "type": "git",
    "url": "https://github.com/an5ORM/an5OrmVScode.git"
  },
  "icon": "icons/an5-128x128.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:an5Orm.config.js",
    "workspaceContains:an5Orm.config.cjs",
    "workspaceContains:**/*.an5"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "an5-schema",
        "aliases": [
          "AN5 Schema",
          "an5-schema"
        ],
        "extensions": [
          ".an5"
        ],
        "icon": {
          "light": "./icons/an5.svg",
          "dark": "./icons/an5.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "an5-schema",
        "scopeName": "source.an5-schema",
        "path": "./syntaxes/an5.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "an5-schema",
        "path": "./snippets/an5-schema.json"
      }
    ],
    "commands": [
      {
        "command": "an5.generate",
        "title": "AN5: Generate Client Code",
        "category": "AN5 ORM",
        "icon": "$(gear)"
      },
      {
        "command": "an5.push",
        "title": "AN5: Push Database Schema",
        "category": "AN5 ORM",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "an5.pull",
        "title": "AN5: Pull Database Schema",
        "category": "AN5 ORM",
        "icon": "$(cloud-download)"
      },
      {
        "command": "an5.openConfig",
        "title": "AN5: Open an5Orm Configuration File",
        "category": "AN5 ORM",
        "icon": "$(settings-gear)"
      },
      {
        "command": "an5.mcp.install",
        "title": "AN5: Install MCP Server",
        "category": "AN5 ORM",
        "icon": "$(robot)"
      },
      {
        "command": "an5.mcp.showConfig",
        "title": "AN5: Show MCP Server Configuration",
        "category": "AN5 ORM",
        "icon": "$(json)"
      },
      {
        "command": "an5.connections.manage",
        "title": "AN5: Manage Database Connections",
        "category": "AN5 ORM",
        "icon": "$(database)"
      },
      {
        "command": "an5.connections.add",
        "title": "AN5: Add Connection",
        "category": "AN5 ORM",
        "icon": "$(add)"
      },
      {
        "command": "an5.connections.refresh",
        "title": "AN5: Refresh Connections",
        "category": "AN5 ORM",
        "icon": "$(refresh)"
      },
      {
        "command": "an5.connections.test",
        "title": "AN5: Test Connection",
        "category": "AN5 ORM",
        "icon": "$(debug-start)"
      },
      {
        "command": "an5.connections.use",
        "title": "AN5: Use Connection",
        "category": "AN5 ORM",
        "icon": "$(plug)"
      },
      {
        "command": "an5.connections.remove",
        "title": "AN5: Delete Connection",
        "category": "AN5 ORM",
        "icon": "$(trash)"
      },
      {
        "command": "an5.schema.refresh",
        "title": "AN5: Refresh Schema Explorer",
        "category": "AN5 ORM",
        "icon": "$(refresh)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "an5McpProvider",
        "label": "AN5 ORM"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "an5",
          "title": "AN5 ORM",
          "icon": "icons/activity.svg"
        }
      ]
    },
    "views": {
      "an5": [
        {
          "id": "an5.connections",
          "name": "Connections"
        },
        {
          "id": "an5.schema",
          "name": "Schema Explorer"
        },
        {
          "id": "an5.actions",
          "name": "Project Actions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "an5.connections",
        "contents": "Open a folder to manage database connections.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "an5.connections.add",
          "when": "view == an5.connections",
          "group": "navigation"
        },
        {
          "command": "an5.connections.refresh",
          "when": "view == an5.connections",
          "group": "navigation"
        },
        {
          "command": "an5.connections.manage",
          "when": "view == an5.connections",
          "group": "navigation"
        },
        {
          "command": "an5.schema.refresh",
          "when": "view == an5.schema",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "an5.connections.test",
          "when": "view == an5.connections && (viewItem == an5Connection || viewItem == an5ProjectConnection)",
          "group": "inline"
        },
        {
          "command": "an5.connections.use",
          "when": "view == an5.connections && (viewItem == an5Connection || viewItem == an5ProjectConnection)",
          "group": "connection@1"
        },
        {
          "command": "an5.connections.manage",
          "when": "view == an5.connections && (viewItem == an5Connection || viewItem == an5ProjectConnection)",
          "group": "connection@2"
        },
        {
          "command": "an5.connections.remove",
          "when": "view == an5.connections && viewItem == an5Connection",
          "group": "connection@3"
        }
      ]
    },
    "configuration": {
      "title": "AN5 ORM",
      "properties": {
        "an5.nodePath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "restricted": true,
          "description": "Absolute path to Node.js for MCP and connection checks. Empty uses Node from PATH, then the editor runtime."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "generate:icons": "node scripts/generate-icons.js",
    "test": "node test/smoke.test.js && node test/snippets.test.js && node test/grammar.test.js && node test/mcp.test.js && node --test test/mcp-regressions.test.js && node --test test/connections.test.js && node --test test/webview-browser.test.js",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish:marketplace": "npx @vscode/vsce publish --no-dependencies",
    "publish:openvsx": "npx ovsx publish",
    "build": "tsc -p ./",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "1.2.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Schema editing is available; connections and project commands require Workspace Trust."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  }
}
