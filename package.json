{
  "name": "an5-orm-vscode",
  "displayName": "AN5 ORM Schema Tooling",
  "description": "Syntax highlighting and formatting for .an5 schema files.",
  "version": "1.0.3",
  "publisher": "an5orm",
  "author": "an5ORM",
  "homepage": "https://github.com/an5ORM/an5OrmVScode",
  "repository": {
    "type": "git",
    "url": "https://github.com/an5ORM/an5OrmVScode.git"
  },
  "icon": "icons/an5-128x128.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:an5-schema",
    "workspaceContains:an5Orm.config.js",
    "workspaceContains:an5Orm.config.cjs",
    "workspaceContains:**/*.an5",
    "onCommand:an5.generate",
    "onCommand:an5.push",
    "onCommand:an5.pull",
    "onCommand:an5.openConfig",
    "onCommand:an5.mcp.showConfig"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "an5-schema",
        "aliases": [
          "AN5 Schema",
          "an5-schema"
        ],
        "extensions": [
          ".an5"
        ],
        "icon": {
          "light": "./icons/an5.svg",
          "dark": "./icons/an5.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "an5-schema",
        "scopeName": "source.an5-schema",
        "path": "./syntaxes/an5.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "an5-schema",
        "path": "./snippets/an5-schema.json"
      }
    ],
    "commands": [
      {
        "command": "an5.generate",
        "title": "AN5: Generate Client Code",
        "category": "AN5 ORM",
        "icon": "$(gear)"
      },
      {
        "command": "an5.push",
        "title": "AN5: Push Database Schema",
        "category": "AN5 ORM",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "an5.pull",
        "title": "AN5: Pull Database Schema",
        "category": "AN5 ORM",
        "icon": "$(cloud-download)"
      },
      {
        "command": "an5.openConfig",
        "title": "AN5: Open an5Orm Configuration File",
        "category": "AN5 ORM",
        "icon": "$(settings-gear)"
      },
      {
        "command": "an5.mcp.showConfig",
        "title": "AN5: Show MCP Server Configuration",
        "category": "AN5 ORM",
        "icon": "$(robot)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "an5McpProvider",
        "label": "AN5 ORM"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "generate:icons": "node scripts/generate-icons.js",
    "test": "node test/smoke.test.js && node test/snippets.test.js && node test/grammar.test.js && node test/mcp.test.js",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish:marketplace": "npx @vscode/vsce publish --no-dependencies",
    "publish:openvsx": "npx ovsx publish",
    "build": "tsc -p ./",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.60.0",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.9.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
