{
  "name": "an5-orm-vscode",
  "displayName": "AN5 ORM Schema Tooling",
  "description": "Syntax highlighting and formatting for .an5 schema files.",
  "version": "1.0.1",
  "publisher": "antigravity",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:an5-schema",
    "workspaceContains:an5Orm.config.js",
    "workspaceContains:an5Orm.config.cjs",
    "workspaceContains:**/*.an5",
    "onCommand:an5.generate",
    "onCommand:an5.push",
    "onCommand:an5.pull",
    "onCommand:an5.openConfig"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "an5-schema",
        "aliases": [
          "AN5 Schema",
          "an5-schema"
        ],
        "extensions": [
          ".an5"
        ],
        "icon": {
          "light": "./icons/an5.svg",
          "dark": "./icons/an5.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "an5-schema",
        "scopeName": "source.an5-schema",
        "path": "./syntaxes/an5.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "an5-schema",
        "path": "./snippets/an5-schema.json"
      }
    ],
    "commands": [
      {
        "command": "an5.generate",
        "title": "AN5: Generate Client Code",
        "category": "AN5 ORM",
        "icon": "$(gear)"
      },
      {
        "command": "an5.push",
        "title": "AN5: Push Database Schema",
        "category": "AN5 ORM",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "an5.pull",
        "title": "AN5: Pull Database Schema",
        "category": "AN5 ORM",
        "icon": "$(cloud-download)"
      },
      {
        "command": "an5.openConfig",
        "title": "AN5: Open an5Orm Configuration File",
        "category": "AN5 ORM",
        "icon": "$(settings-gear)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node test/smoke.test.js && node test/snippets.test.js && node test/grammar.test.js"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.60.0",
    "typescript": "^6.0.3"
  }
}
