{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AN5 Schema",
  "patterns": [
    {
      "name": "comment.line.description.an5",
      "match": "@@?description\\s*\\(\\s*\"([^\"\\\\]|\\\\.)*\"\\s*\\)"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#model-declaration"
    },
    {
      "include": "#field-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.an5",
          "match": "//.*$"
        },
        {
          "name": "comment.block.an5",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "model-declaration": {
      "patterns": [
        {
          "match": "^\\s*(model|enum|datasource|generator|type)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.control.an5"
            },
            "2": {
              "name": "entity.name.type.class.an5"
            }
          }
        }
      ]
    },
    "field-declaration": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z_]\\w*)\\b(?=\\s+(?!=)[A-Za-z_])",
          "captures": {
            "1": {
              "name": "variable.other.property.an5"
            }
          }
        },
        {
          "match": "^\\s*([A-Za-z_]\\w*)\\s*(?==)",
          "captures": {
            "1": {
              "name": "variable.other.property.an5"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.an5",
          "match": "\\b(model|datasource|generator|enum|type|previewFeatures|provider|output|import)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.an5",
          "match": "(?i)\\b(TIME WITH TIME ZONE|TIME WITHOUT TIME ZONE|TIMESTAMP WITH TIME ZONE|TIMESTAMP WITHOUT TIME ZONE|CHARACTER VARYING|VARYING CHARACTER|DOUBLE PRECISION|UNSIGNED BIG INT|BIGINT|BIGSERIAL|BINARY|BIT|BLOB|BOOL|BOOLEAN|BYTEA|BYTES|BYTE|CHAR|CHARACTER|CIDR|CLOB|DATE|DATETIME2|DATETIMEOFFSET|DATETIME|DECIMAL|DOUBLE|ENUM|FIXED|FLOAT|GEOGRAPHY|GEOMETRY|GUID|HIERARCHYID|IMAGE|INET|INTEGER|INT2|INT4|INT8|INT|INTERVAL|JSONB|JSON|LINESTRING|LONGBLOB|LONGTEXT|LONG|MEDIUMBLOB|MEDIUMINT|MEDIUMTEXT|MONEY|NCHAR|NTEXT|NUMERIC|NVARCHAR|POINT|POLYGON|REAL|ROWVERSION|SERIAL|SET|SHORT|SMALLDATETIME|SMALLINT|SMALLMONEY|SMALLSERIAL|SQL_VARIANT|SQLVARIANT|STRING|SYSNAME|TEXT|TIMESTAMPTZ|TIMESTAMP|TIMETZ|TIME|TINYBLOB|TINYINT|TINYTEXT|UNIQUEIDENTIFIER|UUID|VARBINARY|VARCHAR|VARIANT|VECTOR|XML|YEAR)\\b"
        },
        {
          "name": "entity.name.type.class.an5",
          "match": "\\b[A-Z]\\w*(?=\\s*(\\[\\]|\\?|@|//|/\\*|$))"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.an5",
          "match": "\\b(uuid|now|autoincrement|newid|newsequentialid|guid|cuid|dbgenerated|sequence|env)\\b(?=\\s*\\()"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.an5",
          "match": "@@?[a-zA-Z_]\\w*(\\.[a-zA-Z_]\\w*)?"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.an5",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.an5",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.an5",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.an5",
          "match": "\\b(true|false)\\b"
        }
      ]
    }
  },
  "scopeName": "source.an5-schema"
}
